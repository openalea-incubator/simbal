from math import pi
from copy import deepcopy
module Apex(age, alpha)
module Internode(length, radius)
module Leaf(area)
module Petiole(length)

Axiom: Internode(LEN0, RAD0)[&(120)Petiole(0.2)Leaf(AREA0)]Apex(AGE0, ALPHA0)
derivation length: 15

production:
Apex(age, alpha):
  age = deepcopy(age)
  age+=1
  if alpha<360: 
    alpha+=90
  else : 
    alpha = 90
  produce Internode(0, RAD0)[\(alpha)&(120)+(age*pi)Petiole(0)Leaf(AREA0)]Apex(age, alpha) 
Internode(l,r) --> Internode(l+dl,r)
Leaf(area) --> Leaf(area *(1+RGRa))
Petiole(l) --> Petiole(l+dl)

interpretation:
Internode(l,r) --> ,(0)_(r)F(l)
Leaf(area) --> produce ,(2)@g(leafshape,area)
Apex(age, alpha) --> ,(3)@O
Petiole(l) --> ,(6)_(0.01)F(l)
endlsystem
